{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Viewer Advanced",
  "version": "3.0.0",
  "identifier": "com.photovieweradvanced.desktop",
  "mainBinaryName": "PhotoViewerAdvanced",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Photo Viewer Advanced",
      "width": 1150,
      "height": 780,
      "minWidth": 680,
      "minHeight": 460,
      "center": true,
      "visible": false,
      "backgroundColor": "#191919",
      "dragDropEnabled": true,
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../../LICENSE",
    "publisher": "Photo Viewer Advanced",
    "category": "Photography",
    "copyright": "Copyright 2026 Photo Viewer Advanced contributors",
    "shortDescription": "Fast, offline image viewing and animation playback",
    "longDescription": "A simple Windows photo viewer with broad bundled image decoding, animation playback, and basic crop, rotate and flip tools.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/imagemagick/**/*", "resources/licenses/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma",
        "startMenuFolder": "Photo Viewer Advanced"
      }
    }
  }
}
